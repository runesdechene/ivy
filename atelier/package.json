{
  "name": "ivy-atelier",
  "productName": "IVY Atelier",
  "version": "0.1.0",
  "private": true,
  "description": "IVY Atelier : les commandes à imprimer d'IVY, fichiers glissés droit dans le logiciel d'impression.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "test": "node --test src/regles.test.ts",
    "start": "tsc && electron .",
    "installateur": "tsc && electron-builder --win",
    "publier": "pnpm installateur && node scripts/publier.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "typescript": "^5.7.3"
  }
}
